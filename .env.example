# Automated GraphRAG Environment Configuration (Sanitized Example)
# Copy this file to .env and adjust values for your environment.
# Never commit real secrets or API keys to version control.

APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8765

# Storage paths (relative to project root or absolute)
SQLITE_DB_PATH=./data/graphrag.db
MAX_UPLOAD_SIZE_BYTES=10485760

# Authentication, Session Security & RBAC
# Format: api_key:user_id:tenant_id:role (roles: admin, analyst, viewer)
AUTH_API_KEYS=dev-admin-key:user-admin:tenant-alpha:admin,dev-analyst-key:user-analyst:tenant-alpha:analyst,dev-viewer-key:user-viewer:tenant-alpha:viewer,dev-beta-key:user-beta:tenant-beta:analyst
DEFAULT_DEV_API_KEY=dev-admin-key
REQUIRE_AUTH=true
SESSION_TTL_MINUTES=480
COOKIE_SECURE=false

# Bootstrap User Accounts (Seeded on first database initialization if users table is empty)
INITIAL_ADMIN_TENANT=tenant-alpha
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@graphrag.local
INITIAL_ADMIN_PASSWORD=Admin@GraphRAG2026!
INITIAL_ANALYST_PASSWORD=Analyst@GraphRAG2026!
INITIAL_VIEWER_PASSWORD=Viewer@GraphRAG2026!

# Model & Embedding Providers
# Options: local | openai | ollama
LLM_PROVIDER=local
EMBEDDING_PROVIDER=local
EMBEDDING_DIM=128

# OpenAI Configuration (only required if LLM_PROVIDER=openai or EMBEDDING_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Ollama Configuration (only required if LLM_PROVIDER=ollama or EMBEDDING_PROVIDER=ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Graph Storage Backend
# Options: sqlite_networkx | neo4j
GRAPH_BACKEND=sqlite_networkx
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Retrieval Settings
DEFAULT_TOP_K_CHUNKS=6
DEFAULT_MAX_GRAPH_HOPS=2
SIMILARITY_THRESHOLD=0.12
