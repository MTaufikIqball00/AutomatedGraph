{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run build",
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.py?__url=/api/health"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?__url=/api/$1"
    }
  ]
}
