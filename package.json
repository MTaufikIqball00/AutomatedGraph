{
  "name": "automated-graphrag",
  "version": "1.0.0",
  "description": "Production-oriented Automated GraphRAG Enterprise Workspace with Tailwind CSS v3 Design System",
  "private": true,
  "scripts": {
    "start": "python launch.py",
    "build": "node scripts/build.js",
    "build:css": "npx tailwindcss -i ./frontend/input.css -o ./frontend/styles.css --minify",
    "watch:css": "npx tailwindcss -i ./frontend/input.css -o ./frontend/styles.css --watch",
    "test": "pytest -v"
  },
  "dependencies": {
    "tailwindcss": "^3.4.17"
  }
}
